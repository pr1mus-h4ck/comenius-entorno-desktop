<!-- Lista de Comisiones inscriptas -->
<div id="listaComision" class="contenedor-lista-comision"></div> 
<!-- Fin de Lista de Comisiones inscriptas -->
<!-- Actualizar Publicaciones -->
<script>
    function actualizarListaComision() {
        fetch('http://localhost:3000/actualizarListaComision', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(recibir => recibir.json())
        .then(recibido => {
            const listaComision = document.getElementById('listaComision');
            // Limpia el contenido actual
            listaComision.innerHTML = '';
            recibido.comisiones.forEach(comision => {
                const listaComision = document.getElementById('listaComision');
                // Limpia el contenido actual
                listaComision.innerHTML = '';
                recibido.comisiones.forEach(comision => {
                    // Crea el HTML para cada comision
                    const html = `
                        <div class="card-materias">
                        <div>
                        <div><h2 class="title-content">${comision.content}</h2></div>
                        <div class="content-card-materia">
                        <div><p>Comision: XXI</p><p>Turno: Tarde</p></div>
                        <div><p>Miercoles: 18:00 - 20:00</p><p>Viernes: 18:00 - 20:00</p></div>
                        <div><p>Profesor: Profesor</p></div>
                        <div><button class="btn-aceptar" type="submit" onclick="ingresarComisionClick('${comision.content}')">Ingresar</button></div> 
                        </div>
                        </div>
                    `;
                    // Agrega el HTML al contenedor
                    listaComision.innerHTML += html;
                });
            });
        })
    }
    actualizarListaComision();
</script>
<!-- Fin de Actualizar Publicaciones -->