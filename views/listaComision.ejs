<!-- Lista de Comisiones inscriptas -->
<div id="listaComision" class="contenedor-grilla-lista-comision"></div> 
<!-- Fin de Lista de Comisiones inscriptas -->
<!-- Actualizar Publicaciones -->
<script>
    function actualizarListaComision() {
        fetch('/actualizarListaComision', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(recibir => recibir.json())
        .then(recibido => {
            const listaComision = document.getElementById('listaComision');
            listaComision.innerHTML = ''; // Limpia el contenedor solo una vez
            recibido.comision.forEach(comision => { // Usa 'comision', no 'comisiones'
                const html = `
                    <div class="card-materias">
                        <div>
                            <div><h2 class="title-content">${comision.Materia}</h2></div>
                            <div class="content-card-materia">
                                <div><p>Comision: ${comision.Comision}</p><p>Turno: ${comision.Turnos}</p></div>
                                <div><p>${comision.Horarios}</p></div>
                                <div><p>Profesor: ${comision.Instructores}</p></div>
                                <div><button class="btn-aceptar btn-style" type="submit" onclick="ingresarComisionClick('${comision.Materia}', '${comision.Comision_ID}')">Ingresar</button></div> 
                            </div>
                        </div>
                    </div>
                `;
                // Agrega el HTML al contenedor
                listaComision.innerHTML += html;
            });
        })
        .catch(error => {
            servidorAviso();
        });
    }
    actualizarListaComision();
</script>
<!-- Fin de Actualizar Publicaciones -->