<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Hola mundo</h1>
<button onclick="subirFoto()">Enviar</button>
<script>
    function subirFoto() {
        /*let hola = 'hola';
        let iniciarJson = JSON.stringify(hola);
        fetch('/cloudinaryPrueba', {
                method: 'Post',
                body: iniciarJson
            })*/
    let hola = 'hola';
    let iniciarJson = JSON.stringify(hola);
    fetch('/cloudinaryPrueba', {
        method: 'Post',
        body: JSON.stringify({ data: iniciarJson }),
        header:  {
            'Content-Type': 'application/json'
        }
    })
    .then(response => {
        if (!response.ok) {
            throw new Error('Network response was not ok');
        }
        return response.json();
    })
    .then(data => {
        console.log(data);
    })
    .catch(error => {
        console.error('Error:', error);
    });
    console.log(iniciarJson);
    //window.location.href = '/';
}
</script>
</body>
</html>
