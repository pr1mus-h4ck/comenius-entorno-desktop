<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
<form action="/cloudinaryPrueba" method="post" id="uploadForm" enctype="multipart/form-data">
    <input type="file" id="fileInput" accept=".png">
    <button type="button" onclick="uploadPhoto()">Subir Foto</button>
</form>
<script>
    function uploadPhoto() {
        const fileInput = document.getElementById('fileInput');
        const file = fileInput.files[0];

        if (file instanceof Blob) {
            const reader = new FileReader();
            reader.onload = function(event) {
                const base64Image = event.target.result;
                const imageData = { image: base64Image };

                fetch('/upload-photo', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(imageData)
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(data => {
                    console.log(data);
                })
                .catch(error => {
                    console.error('Error:', error);
                });
            };

            reader.readAsDataURL(file);
        } else {
            console.error('El archivo seleccionado no es válido');
        }
    }
</script>
</body>
</html>