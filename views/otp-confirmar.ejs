<div class="form-box login">
    <div class="form-otp">
    <div class="text-cabecera-login">
        <p>Paso 2/2</p>
        <h2>OTP Verificacion</h2> 
        <p>Comprobacion por Email</p>
    </div>
    <div class="text-content">
        <p>Ingresa el código que hemos enviado.</p>
    </div>
    <form action="/confirmar-otp" method="post"> 
        <div class="content-input-otp">
            <div>
                <label for="input1"></label>
                <input type="text" name='input1' maxlength="1" id="input1" oninput="activateNextInput(this, 2)">
            </div>
            <div>
                <label for="input2"></label>
                <input type="text" name='input2' maxlength="1" id="input2" oninput="activateNextInput(this, 3)" disabled>
            </div>
            <div>
                <label for="input3"></label>
                <input type="text" name='input3' maxlength="1" id="input3" oninput="activateNextInput(this, 4)" disabled>
            </div>
            <div>
                <label for="input4"></label>
                <input type="text" name='input4' maxlength="1" id="input4" oninput="activateNextInput(this, 5)" disabled>
            </div>
            <div>
                <label for="input5"></label>
                <input type="text" name='input5' maxlength="1" id="input5" oninput="activateNextInput(this, 6)" disabled>
            </div>
            <div>
                <label for="input6"></label>
                <input type="text" name='input6' maxlength="1" id="input6" oninput="activateNextInput(this, 7)" disabled>
            </div>
        </div>
            <% if (sesiones.otp) { %>

        <div class="text-otp">
            <p id="otp"><%= sesiones.otp %></p>
        </div>

            <% } %>
        <div>
            <button class="btn btn-aceptar" type="submit">Enviar</button>
        </div>
    </form>
</div>
</div>
<div class="toggle-box">
    <div class="toggle-panel toggle-left">
        <img src="./recursos/img/pre-logo.svg" alt="" class="imagen-form-login">
        <h2>¿Te arrepentiste?</h2>
        <p>Haz click en "Cancelar" para volver a iniciar.</p>
        <button class="btn btn-aceptar" onclick="avisoCancelar();">Cancelar</button>
    </div>
</div>
<script>
    function activateNextInput(currentInput, nextInputIndex) {
        if (currentInput.value.length === 1) {
            if (nextInputIndex <= 6) {
                let nextInput = document.getElementById("input" + nextInputIndex);
                nextInput.disabled = false;
                nextInput.focus();
            }
        } else {
            let previousInputIndex = nextInputIndex - 2;
            if (previousInputIndex >= 1) {
                let previousInput = document.getElementById("input" + previousInputIndex);
                previousInput.focus();
            }
        }
    }
    document.addEventListener('paste', function(event) {
        let clipboardData = event.clipboardData || window.clipboardData;
        let pastedText = clipboardData.getData('text');
        let inputs = document.getElementsByTagName('input');
        for (var i = 0; i < pastedText.length; i++) {
            if (i < inputs.length) {
                inputs[i].value = pastedText[i];
                inputs[i].disabled = false;
            }
        }
    });
</script>
<script>
    function avisoCancelar() {
        document.getElementById('contenido').style.display = 'block';
        document.getElementById('alerta-personalizada').style.display = 'block';
        document.getElementById('alerta-personalizada').classList.add('aviso');
        document.getElementById('titulo-alerta-personalizada').innerHTML = 'Estás a punto de Cancelar el<br>Proceso de Autenticación';
        document.getElementById('mensaje-alerta-personalizada').innerHTML = '¿Estás seguro/a de querer Cancelar el Proceso?';
        document.getElementById('boton-alerta-cancelar').style.display = 'block';
        document.getElementById('boton-alerta-no-cancelar').style.display = 'block';
    }
    function redirigir() {
        window.location.href = '/';
    }
</script>