<!-- Información de la Comisión -->
<div id="contenidoPortada"  class="contenedor-portada"></div>
<!-- Fin de Información de la Comisión -->
<!-- Actualizar Información de Portada -->
<script>
    function actualizarPortada() {
        fetch('/actualizarPortada', { 
            method: 'POST', 
            headers: { 
                'Content-Type': 'application/json'
            }
        })
        .then(recibir => recibir.json())
        .then(recibido => {
            const contenidoPortada = document.getElementById('contenidoPortada');
            contenidoPortada.innerHTML = ''; // Limpia el contenido actual
            if (!recibido.tipo) {
                recibido.portada.forEach(portada => {
                    const html = `
                    <div class="div-portada">
                        <h3>Objetivos</h3>
                        <div>
                            <p>${portada.Objetivo}</p>
                        </div>
                    </div>
                    <div class="div-portada">
                        <h3>Evaluación de la cursada</h3>
                        <div>
                            <p>${portada.EvaluacionCursada}</p>
                        </div>
                    </div>
                    `;
                    // Agrega el HTML al contenedor
                    contenidoPortada.innerHTML += html;
                })
            } else {
                const html = `
                    <p class="texto-informacion">${recibido.mensaje}</p>
                `;
                // Agrega el HTML al contenedor
                contenidoPortada.innerHTML += html;
            }
        });
    }
    actualizarPortada();
</script>
<!-- Fin de Actualizar Información de Portada -->