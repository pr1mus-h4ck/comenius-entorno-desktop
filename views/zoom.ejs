<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="Content-Type" content="application/javascript; charset=UTF-8">
    <title>Videollamada</title>

    <script src="https://source.zoom.us/3.9.0/lib/vendor/react.min.js"></script>
    <script src="https://source.zoom.us/3.9.0/lib/vendor/react-dom.min.js"></script>
    <script src="https://source.zoom.us/3.9.0/lib/vendor/redux.min.js"></script>
    <script src="https://source.zoom.us/3.9.0/lib/vendor/redux-thunk.min.js"></script>
    <script src="https://source.zoom.us/3.9.0/lib/vendor/lodash.min.js"></script>
    
    <script defer src="https://source.zoom.us/zoom-meeting-3.9.0.min.js"></script>

</head>
<body>
    <form action="/zoomPrueba" id="testZoom" method="post">
        <button type="submit">Entrar a la llamada</button>
    </form>
    <% function base64Encode(str) { %>
        <%= btoa(unescape(encodeURIComponent(str))) %>
    <% } %>

    <iframe src="https://zoom.us/wc/<%= almacenamiento.id %>/join?pwd=<%= almacenamiento.password %>&wc=true&no_dr=true&no_titlebar=true&un=<%= base64Encode(sesiones.nombre) %>&clientId=<%= almacenamiento.clientId %>&zoomFirma=<%= almacenamiento.zoomFirma %>" frameborder="0" width="500" height="500"></iframe>
    <script> 
    document.getElementById('testZoom').addEventListener('submit', (e) => {
    e.preventDefault();

    fetch('/zoomPrueba', {
        method: 'POST',
        body: JSON.stringify({ message: 'hola' }),
        headers: {
            'Content-Type': 'application/json'
        }
    })
    .then(respuesta => {
                // Si la respuesta es correcta
                if (respuesta.ok) {
                    // Cargar la ventana en la ruta '/'
                    window.location.href = '/';
                    //console.log('funcionó la petición'); //Esto se imprime del lado de la consola del navegador
                } else {
                    // Si sale error cargar en la consola del Navegador el error
                    console.error('No carga el zoom');
                }
            })
        })
    .catch(error => console.error('Error al hacer la petición:', error));

    </script>
</body>
</html>

