<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form action="/zoomPrueba" id="testZoom" method="post">
        <button type="submit">Click</button>
    </form>
    <script src="/js/zoom.js"></script>
    <script>
        document.getElementById('testZoom').addEventListener('submit', (e) => {
            e.preventDefault();
            const json = { message: 'hola' };
            fetch('/zoomPrueba', {
                method: 'POST',
                body: JSON.stringify(json),
                headers: {
                    'Content-Type': 'application/json'
                }
            }).then(recibir => recibir.json())
            .then(recibido => {
                const meetingUrl = recibido.meetingUrl;
                createIframe(meetingUrl);
            }); 
        })
    </script>
</body>
</html>