<!DOCTYPE html>
<html lang="en">
    <meta http-equiv="Content-Type" content="application/javascript; charset=UTF-8">
    <title>Document</title>
</head>
<body>
    <h1>
        <%= zoom.url %>
    </h1>
    <form action="/zoomPrueba" id="testZoom" method="post">
        <button type="submit">Click</button>
    </form>
    <script> 
        document.getElementById('testZoom').addEventListener('submit', (e) => {
            e.preventDefault();
            const json = { message: 'hola' };
            fetch('/zoomPrueba', {
                method: 'POST',
                body: JSON.stringify(json),
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(respuesta => {
                // Si la respuesta es correcta
                if (respuesta.ok) {
                    // Cargar la ventana en la ruta '/'
                    window.location.href = '/';
                    //console.log('funcionó la petición'); //Esto se imprime del lado de la consola del navegador
                } else {
                    // Si sale error cargar en la consola del Navegador el error
                    console.error('No carga el zoom');
                }
            })
        })
    </script>
</body>
</html>