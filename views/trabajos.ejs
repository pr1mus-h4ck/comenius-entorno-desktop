<!-- Trabajos -->
<div>
    <% if (sesiones.rol === 'alumno') { %> <!-- Si es alumno -->
        <% if (sesiones.trabajo) { %>
            <%- include('trabajo.ejs') %>
        <% } else { %>
            <%- include('listaTrabajo.ejs') %>
        <% } %>
    <% } else { %> <!-- Si es instructor -->
        <% if (sesiones.trabajo) { %>
            <% if (!sesiones.alumno) { %>
                <%- include('listaAlumno.ejs') %>
            <% } else { %>
                <%- include('trabajo.ejs') %>
            <% } %>
        <% } else { %>
            <%- include('listaTrabajo.ejs') %>
        <% } %>
    <% } %>
</div>
<!-- Fin de Trabajos -->