<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Video clase</title>
</head>
<body>
    <h1>Videollamada</h1>
    <iframe id="videoFrame" title="Videollamada" width="800" height="600"></iframe>
    
    <script>
        fetch('http://localhost:3000/getMeetingUrl')
        .then(response => response.json())
        .then (data => {
            const meetingUrl = data.meetingUrl;
            const videoFrame = document.getElementById('videoFrame');
            videoFrame.src = meetingUrl;
        })
        .catch(error => console.error(error));
    </script>
</body>
</html>