<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/public/css/estilos.css">
    <title>Index</title>
</head>
<body>
    <div id="contenido">
    <h1>Index</h1>
    <p>La sesión iniciada <%= sesiones.correo %></p>
        <ul>
            <li>Inicio</li>
            <li>Panel de materias</li>
            <li>Grupos</li>
            <li>Calendario</li>
            <li>Notificaciones</li>
            <li>Metodos de pago</li>
        </ul>
    <% if (sesiones.rol !== '') { %>
        <% if (sesiones.rol === 'alumno') { %>
            <%- include('dash-alumno.html') %>
        <% } else if (sesiones.rol === 'profesor') { %>
            <%- include('dash-profesor.html') %>
        <% } else if (sesiones.rol === 'coordinador') { %>
            <%- include('dash-coordinador.html') %>
        <% } else if (sesiones.rol === '') { %>
            <%- include('dash-secretaria.html') %>
        <% } else if (sesiones.rol === 'departamento de alumnos') { %>
            <%- include('dash-departamento-alumno.html') %>
        <% } else if (sesiones.rol === 'usuario especial') { %>
            <%- include('dash-usuario-especial.html') %>
        <% } else if (sesiones.rol === 'soporte') { %>
            <%- include('dash-soporte-sistemas.html') %>
        <% } %>
<% } %>
<!--TODO: primero configurar el active en JS, luego hacer los INCLUDE por cada opción del menú y convertir el valor del ACTIVE e incrustarlo en una variable-->  
</div>
</body>
</html>