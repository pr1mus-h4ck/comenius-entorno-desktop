<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comenius Virtual School</title>
    <link rel="shortcut icon" href="./recursos/img/mini-logo.svg">
    <link rel="stylesheet" href="recursos/css/index.css">
    <link rel="stylesheet" href="recursos/css/alerta.css">
</head>
<body>
    <div class="contenedor-index">
        <nav id="sidebar">
            <!-- Logo de CVS en entorno Web -->
            <img class="iconCVSWeb" src="./recursos/img/icon-navbar1.svg" alt="icon-navbar1" title="Comenius Virtual School">
            <!-- Fin de Logo de CVS en entorno Web -->
            <!-- Iteración del array 'menu' -->
            <% if (menu) { %>
                <ul>
                    <% menu.forEach(item => { %>
                        <%
                            // Determina la fuente de imagen correcta
                            let imgSrc = item.image;
                            let isActive = sesiones.rol && !sesiones.enlace && !sesiones.comision || sesiones.item === item.label && !sesiones.enlace && !sesiones.comision;
                            // Si el elemento está activo y se proporciona un imageHover.
                            if (isActive && item.imageHover) {
                                imgSrc = item.imageHover;
                            }
                        %>
                         <li>
                            <a class="<%= (isActive) ? 'active' : '' %>" href="#" onclick="manejarMenuClick('<%= item.label %>')" title="<%= item.label %>" data-default-src="<%= item.image %>" data-hover-src="<%= item.imageHover || item.image %>" onmouseover="if (!this.classList.contains('active')) { this.querySelector('img').src = this.dataset.hoverSrc; }" onmouseout="if (!this.classList.contains('active')) { this.querySelector('img').src = this.dataset.defaultSrc; }">
                                <img src="<%= imgSrc %>" alt="<%= item.label %>">
                            </a>
                        </li>
                    <% }) %>
                </ul> 
            <% } %>
            <!-- Fin de Iteración del array 'menu' -->
            <!-- Logo de CVS en entorno Mobile -->
            <img class="iconCVSMobile" src="./recursos/img/icon-navbar1.svg" alt="icon-navbar1" title="Comenius Virtual School">
            <!-- Fin de Logo de CVS en entorno Mobile -->
            <!-- Botón que activa la función 'avisoCerrarSesion()' -->
            <button onclick="avisoCerrarSesion()" title="Cerrar Sesión">
                <img src="./recursos/img/logout-black.svg" alt="Cerrar Sesión">
            </button>
            <!-- Fin de Botón que activa la función 'avisoCerrarSesion()' -->
        </nav>
        <div class="contenedor-secciones">
            <% if (sesiones.item) { %>
                <%- include(`${sesiones.item}.ejs`) %>
            <% } else { %>
                <%- include('inicio.ejs') %>
            <% } %>
        </div>
    </div>
    <!-- Etiquetas cuando se activa una alerta -->
    <div id="contenido" class="contenido"></div>
    <div id="alerta-personalizada" class="alerta-personalizada">
        <div class="contenido-alerta-personalizada">
            <h2 id="titulo-alerta-personalizada"></h2>
            <p id="mensaje-alerta-personalizada"></p>
            <button id="boton-alerta-personalizada" onclick="redirigir()">Aceptar</button>
            <form id="boton-alerta-cerrar" action="/cerrar-sesion" method="post">
                <button type="submit">Si, quiero Cerrar la Sesión</button>
            </form>
            <button id="boton-alerta-no-cerrar" onclick="redirigir()">No, me equivoque</button>
        </div>
    </div>
    <!-- Fin de Etiquetas cuando se activa una alerta -->
    <script>
        // Función para manejar el clic en un elemento del menú
        function manejarMenuClick(item) {
            const dato = {
                menu: item,
            }
            const datoJson = JSON.stringify(dato);
            // Hace una petición en '/cargarPagina' con el método POST en el mismo puerto que corre el front, enviando 'dato' en formato JSON
            fetch(`/cargarPagina`, {
                method: 'Post',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: datoJson,
            })
            .then(respuesta => {
                // Si la respuesta es correcta
                if (respuesta) {
                    // Cargar la ventana en la ruta '/'
                    window.location.href = '/';
                } else {
                    // Si sale error cargar en la consola del Navegador el error
                    console.error('Error al hacer la petición');
                }
            })
        }
        // Función para manejar el clic en el botón de cerrar sesión
        function avisoCerrarSesion() {
            // Activo el estilo bloqueado, '#contenido' por 'alertas.css'
            document.getElementById('contenido').style.display = 'block';
            // Activo el estilo bloqueado, '#alerta-personalizada' por 'alertas.css'
            document.getElementById('alerta-personalizada').style.display = 'block';
            // Agrego una clase a la etiqueca con la ID '#alerta-personalizada' para cambiar el color de la alerta
            document.getElementById('alerta-personalizada').classList.add('aviso');
            // Agrego texto a la etiqueta con la ID '#titulo-alerta-personalizada'
            document.getElementById('titulo-alerta-personalizada').innerHTML = 'Estás a punto de Cerrar la Sesión';
            // Agrego texto a la etiqueta con la ID '#mensaje-alerta-personalizada'
            document.getElementById('mensaje-alerta-personalizada').innerHTML = '¿Estás seguro/a de querer Cerrar la Sesión?';
            // Activo el estilo bloqueado, '#boton-alerta-cerrar' por 'alertas.css'
            document.getElementById('boton-alerta-cerrar').style.display = 'block';
            // Activo el estilo bloqueado, '#boton-alerta-no-cerrar' por 'alertas.css'
            document.getElementById('boton-alerta-no-cerrar').style.display = 'block';
        }
        // Función para visualizar campos obligatorios listaTrabajos.ejs
        function listaTrabajosAviso() {
            // Activo el estilo bloqueado, '#contenido' por 'alertas.css'
            document.getElementById('contenido').style.display = 'block';
            // Activo el estilo bloqueado, '#alerta-personalizada' por 'alertas.css'
            document.getElementById('alerta-personalizada').style.display = 'block';
            // Agrego una clase a la etiqueca con la ID '#alerta-personalizada' para cambiar el color de la alerta
            document.getElementById('alerta-personalizada').classList.add('obligatorio');
            // Agrego texto a la etiqueta con la ID '#titulo-alerta-personalizada'
            document.getElementById('titulo-alerta-personalizada').innerHTML = 'Campos Obligatorios';
            // Agrego texto a la etiqueta con la ID '#mensaje-alerta-personalizada'
            document.getElementById('mensaje-alerta-personalizada').innerHTML = 'Los campos "Título" y "Contenido" son obligatorios';
            // Mostrar el botón en caso de error o advertencia
            document.getElementById('boton-alerta-personalizada').style.display = 'block';
        }
        // Función para visualizar campos obligatorios panel_de_clase.ejs
        function panelClaseAviso() {
            // Activo el estilo bloqueado, '#contenido' por 'alertas.css'
            document.getElementById('contenido').style.display = 'block';
            // Activo el estilo bloqueado, '#alerta-personalizada' por 'alertas.css'
            document.getElementById('alerta-personalizada').style.display = 'block';
            // Agrego una clase a la etiqueca con la ID '#alerta-personalizada' para cambiar el color de la alerta
            document.getElementById('alerta-personalizada').classList.add('obligatorio');
            // Agrego texto a la etiqueta con la ID '#titulo-alerta-personalizada'
            document.getElementById('titulo-alerta-personalizada').innerHTML = 'Campos Obligatorios';
            // Agrego texto a la etiqueta con la ID '#mensaje-alerta-personalizada'
            document.getElementById('mensaje-alerta-personalizada').innerHTML = 'El campo "Contenido" es obligatorio';
            // Mostrar el botón en caso de error o advertencia
            document.getElementById('boton-alerta-personalizada').style.display = 'block';
        }
        function servidorAviso() {
            // Activo el estilo bloqueado, '#contenido' por 'alertas.css'
            document.getElementById('contenido').style.display = 'block';
            // Activo el estilo bloqueado, '#alerta-personalizada' por 'alertas.css'
            document.getElementById('alerta-personalizada').style.display = 'block';
            // Agrego una clase a la etiqueca con la ID '#alerta-personalizada' para cambiar el color de la alerta
            document.getElementById('alerta-personalizada').classList.add('error');
            // Agrego texto a la etiqueta con la ID '#titulo-alerta-personalizada'
            document.getElementById('titulo-alerta-personalizada').innerHTML = 'Error';
            // Agrego texto a la etiqueta con la ID '#mensaje-alerta-personalizada'
            document.getElementById('mensaje-alerta-personalizada').innerHTML = 'En este momento ha ocurrido un error al establecer conexión con el servidor, vuelva intentarlo más tarde';
            // Mostrar el botón en caso de error o advertencia
            document.getElementById('boton-alerta-cerrar').style.display = 'block';
            // Línea para modificar el botón #boton-alerta-cerrar
            document.querySelector('#boton-alerta-cerrar > button').innerHTML = 'Aceptar';
        }
        // Función para redirigir a la ruta '/'
        function redirigir() {
            // Carga la ventana en la ruta '/'
            window.location.href = '/';
        }
    </script>
</body>
</html>