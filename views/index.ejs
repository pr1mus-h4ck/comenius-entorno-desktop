<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/public/css/estilos.css">
    <title>Index</title>
</head>
<body>
    <div id="contenido">
    <h1>Index</h1>
    <p>La sesión iniciada <%= sesiones.correo %></p>
    <% if (sesiones.rol !== '') { %>
        <% if (sesiones.rol === 'alumno') { %>
            <%- include('dash-alumno.html') %>
        <% } else if (sesiones.rol === 'profesor') { %>
            <%- include('dash-profesor.html') %>
        <% } else if (sesiones.rol === 'coordinador') { %>
            <%- include('dash-coordinador.html') %>
        <% } else if (sesiones.rol === '') { %>
            <%- include('dash-secretaria.html') %>
        <% } else if (sesiones.rol === 'departamento de alumnos') { %>
            <%- include('dash-departamento-alumno.html') %>
        <% } else if (sesiones.rol === 'usuario especial') { %>
            <%- include('dash-usuario-especial.html') %>
        <% } else if (sesiones.rol === 'soporte') { %>
            <%- include('dash-soporte-sistemas.html') %>
        <% } %>
    <% } %>
</div>
<body>
    <aside class="menuV">
        <a href=""><i class="fa-solid fa-house-user"></i>Inicio</a>
        <a href=""><i class="fa-solid fa-bookmark"></i>Materias</a>
        <a href=""><i class="fa-solid fa-people-group"></i>Grupos</a>
        <a href=""><i class="fa-regular fa-calendar-days"></i>Calendario</a>
        <a href=""><i class="fa-solid fa-volume-high"></i>Notificaciones</a>
        <a href=""><i class="fa-solid fa-credit-card"></i>Metodos de pago</a>
        <a href=""><i class="fa-solid fa-credit-card"></i>Videollamada</a>
    </aside>
</body>
</body>
</html>