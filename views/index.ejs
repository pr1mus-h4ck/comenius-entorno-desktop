<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comenius Virtual School</title>
    <link rel="shortcut icon" href="./recursos/img/mini-logo.svg">
    <link rel="stylesheet" href="recursos/css/index.css">
    <link rel="stylesheet" href="recursos/css/alerta.css">
</head>
<body>
    <div class="contenedor-index">
        <nav id="sidebar">
            <!-- Iteración del array 'menu' -->
            <% if (menu) { %>
                <ul>
                    <% menu.forEach(item => { %>
                        <li><a href="#" onclick="manejarMenuClick('<%= item %>')" title="<%= item %>"><%= item %></a></li>
                    <% }) %>
                </ul> 
            <% } %>
            <!-- Fin de Iteración del array 'menu' -->
            <!-- Botón que activa la función 'avisoCerrarSesion()' -->
            <button onclick="avisoCerrarSesion()">Cerrar Sesión</button>
            <!-- <ul>
                <li class="icon-logo">
                    <img src="./recursos/img/icon-navbar1.svg" alt="">
                </li>
                <li class="active">
                    <a>
                        <img src="./recursos/img/icon-navbar2.svg" alt="" class="hover-img">
                    </a>
                </li>
                <li>
                    <a>
                        <img src="./recursos/img/icon-navbar3.svg" alt="" class="hover-img">
                    </a>
                </li>
                <li class="icon-exit">
                    <a>
                        <button class="btn-notificaciones-exit" onclick="avisoCerrarSesion()">
                            <img src="./recursos/img/icon-navbar4.svg" alt="" class="hover-img">
                        </button>
                    </a>
                </li>
            </ul> -->
        </nav>
        <div class="contenedor-secciones">
            <div class="item0">

                <div class="content-icons-nav">
                    <div class="icon-notificacion">
                        <button class="btn-notificacion">
                            <img src="./recursos/img/icon-notificaciones.svg" alt="">    
                        </button>
                    </div>   
                    <div class="icon-perfil">
                        <img src="./recursos/img/icon-perfil.svg" alt="">
                        <p><%= sesiones.nombre %></p>
                    </div>
                </div>
            </div>
            <% if (sesiones.item) { %>
                <%- include(`${sesiones.item}.ejs`) %>
            <% } else { %>
                <%- include('inicio.ejs') %>
            <% } %>
        </div>
    </div>
    <!-- Fin de Botón que activa la función 'avisoCerrarSesion()' -->
    <!-- Etiquetas cuando se activa una alerta -->
    <div id="contenido" class="contenido"></div>
    <div id="alerta-personalizada" class="alerta-personalizada">
        <div class="contenido-alerta-personalizada">
        <h2 id="titulo-alerta-personalizada"></h2>
        <p id="mensaje-alerta-personalizada"></p>
        <button id="boton-alerta-personalizada" onclick="redirigir()">Aceptar</button>
        <form id="boton-alerta-cerrar" action="/cerrar-sesion" method="post">
            <button type="submit">Si, quiero Cerrar la Sesión</button>
        </form>
        <button id="boton-alerta-no-cerrar" onclick="redirigir()">No, me equivoque</button>
    </div>
    <!-- Fin de Etiquetas cuando se activa una alerta -->
    <script>
        // Función para manejar el clic en un elemento del menú
        function manejarMenuClick(item) {
            const dato = {
                menu: item,
            }
            const datoJson = JSON.stringify(dato);
            // Hace una petición en '/cargarPagina' con el método POST en el mismo puerto que corre el front, enviando 'dato' en formato JSON
            fetch(`/cargarPagina`, {
                method: 'Post',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: datoJson,
            })
            .then(respuesta => {
                // Si la respuesta es correcta
                if (respuesta) {
                    // Cargar la ventana en la ruta '/'
                    window.location.href = '/';
                } else {
                    // Si sale error cargar en la consola del Navegador el error
                    console.error('Error al hacer la petición');
                }
            })
        }
        // Función para manejar el clic en el botón de cerrar sesión
        function avisoCerrarSesion() {
            // Activo el estilo bloqueado, '#contenido' por 'alertas.css'
            document.getElementById('contenido').style.display = 'block';
            // Activo el estilo bloqueado, '#alerta-personalizada' por 'alertas.css'
            document.getElementById('alerta-personalizada').style.display = 'block';
            // Agrego una clase a la etiqueca con la ID '#alerta-personalizada' para cambiar el color de la alerta
            document.getElementById('alerta-personalizada').classList.add('aviso');
            // Agrego texto a la etiqueta con la ID '#titulo-alerta-personalizada'
            document.getElementById('titulo-alerta-personalizada').innerHTML = 'Estás a punto de Cerrar la Sesión';
            // Agrego texto a la etiqueta con la ID '#mensaje-alerta-personalizada'
            document.getElementById('mensaje-alerta-personalizada').innerHTML = '¿Estás seguro/a de querer Cerrar la Sesión?';
            // Activo el estilo bloqueado, '#boton-alerta-cerrar' por 'alertas.css'
            document.getElementById('boton-alerta-cerrar').style.display = 'block';
            // Activo el estilo bloqueado, '#boton-alerta-no-cerrar' por 'alertas.css'
            document.getElementById('boton-alerta-no-cerrar').style.display = 'block';
        }
        // Función para redirigir a la ruta '/'
        function redirigir() {
            // Carga la ventana en la ruta '/'
            window.location.href = '/';
        }
    </script>
</body>
</html>