<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/public/css/estilos.css">
    <title>Index</title>
</head>
<body>
    <div id="contenido">
    <h1>Index</h1>
    <p>La sesión iniciada <%= sesiones.correo %></p>
        <ul>
            <% let menu = [
            inicio, 
            panel_de_materias, 
            grupos,
            notificaciones,
            calendario,
            registro
            ] 
            %>  
            <% menu.foreach(menu =>  { %>     
                <li name="opcion"><a href="/redireccionar"><%menu%></a></li>
                <% }); %>
        </ul>

    <!--includes del menú-->
    <% if (isfileexist('/views')) { %>  
        <% if (menu[0]) { %> <!--SI la posicion del menu está en 0-->
            <% if (sesiones.rol !== '') { %> <!--SI tiene un rol-->
                <% if (sesiones.rol === 'alumno') { %>  <!--SI el usuario tiene ROL ALUMNO y continua con el resto de los roles -->
                    <%- include('dash-alumno.html') %>
                <% } else if (sesiones.rol === 'profesor') { %>
                    <%- include('dash-profesor.html') %>
                <% } else if (sesiones.rol === 'coordinador') { %>
                    <%- include('dash-coordinador.html') %>
                <% } else if (sesiones.rol === 'secretaria') { %>
                    <%- include('dash-secretaria.html') %>
                <% } else if (sesiones.rol === 'departamento de alumnos') { %>
                    <%- include('dash-departamento-alumno.html') %>
                <% } else if (sesiones.rol === 'usuario especial') { %>
                    <%- include('dash-usuario-especial.html') %>
                <% } else if (sesiones.rol === 'soporte') { %>
                    <%- include('dash-soporte.html') %>
                    <% } %>
                <% } %>
            <% } %>
            <% } %>

    <!--include de los dash en general-->
    <% if (sesiones.rol !== '') { %>
        <% if (sesiones.rol === 'alumno') { %>
            <%- include('dash-alumno.html') %>
        <% } else if (sesiones.rol === 'profesor') { %>
            <%- include('dash-profesor.html') %>
        <% } else if (sesiones.rol === 'coordinador') { %>
            <%- include('dash-coordinador.html') %>
        <% } else if (sesiones.rol === '') { %>
            <%- include('dash-secretaria.html') %>
        <% } else if (sesiones.rol === 'departamento de alumnos') { %>
            <%- include('dash-departamento-alumno.html') %>
        <% } else if (sesiones.rol === 'usuario especial') { %>
            <%- include('dash-usuario-especial.html') %>
        <% } else if (sesiones.rol === 'soporte') { %>
            <%- include('dash-soporte-sistemas.html') %>
        <% } %>
<% } %>

</div>
</body>
</html>