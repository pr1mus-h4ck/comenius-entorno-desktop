<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Index</title>
    <link rel="stylesheet" href="recursos/css/index.css">
    <link rel="stylesheet" href="recursos/css/alerta.css">
</head>
<body>
    <h1>Index</h1>
    <p>La sesión iniciada <%= sesiones.sesion %></p>
    <% if (menu) { %>
        <ul>
            <% menu.forEach(item => { %>
                <li><a href="#" onclick="manejarMenuClick('<%= item %>')"><%= item %></a></li>
            <% }) %>
        </ul>
    <% } %>
    <% if (sesiones.item) { %>
        <%- include(`${sesiones.item}.ejs`) %>
    <% } else { %>
        <%- include('inicio.ejs') %>
    <% } %>
    <!-- TODO: Hacer la funcion include como interacción con el menú -->
    <button onclick="avisoCerrarSesion();">Cerrar Sesión</button>
    <div id="contenido" class="contenido"></div>
    <div id="alerta-personalizada" class="alerta-personalizada">
        <div class="contenido-alerta-personalizada">
        <h2 id="titulo-alerta-personalizada"></h2>
        <p id="mensaje-alerta-personalizada"></p>
        <button id="boton-alerta-personalizada" onclick="redirigir()">Aceptar</button>
        <form id="boton-alerta-cerrar" action="/cerrar-sesion" method="post">
            <button type="submit">Si, quiero Cerrar la Sesión</button>
        </form>
        <button id="boton-alerta-no-cerrar" onclick="redirigir()">No, me equivoque</button>
    </div>
    <!-- TODO: Hacer una función que solicite peticiones para cada vista -->
    <script>
        // Función para manejar el clic en un elemento del menú
        function manejarMenuClick(item) {
            console.log(item);
            datos = { menu: item };
            fetch('/cargarPagina', {
                method: 'Post',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(datos)
            })
            .then(respuesta => {
                if (respuesta.ok) {
                    window.location.href = '/';
                } else {
                    console.error('Error al hacer la petición');
                }
            })
        }
        function avisoCerrarSesion() {
            document.getElementById('contenido').style.display = 'block';
            document.getElementById('alerta-personalizada').style.display = 'block';
            document.getElementById('alerta-personalizada').classList.add('aviso');
            document.getElementById('titulo-alerta-personalizada').innerHTML = 'Estás a punto de Cerrar la Sesión';
            document.getElementById('mensaje-alerta-personalizada').innerHTML = '¿Estás seguro/a de querer Cerrar la Sesión?';
            document.getElementById('boton-alerta-cerrar').style.display = 'block';
            document.getElementById('boton-alerta-no-cerrar').style.display = 'block';
        }
        function redirigir() {
            window.location.href = '/';
        }
    </script>
</body>
</html>