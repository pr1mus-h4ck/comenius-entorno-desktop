<div class="contenedor-materias">
    <!-- Iteración del array 'comision' -->
    <div class="contenedor-submenu">
        <% if (comision) { %>
            <ul>
                <% comision.forEach(item => { %>
                    <%
                        // Determina la fuente de imagen correcta
                        let imgSrc = item.image;
                        let isActive = sesiones.rol && !sesiones.enlace && item.label === 'Portada' || sesiones.enlace === 'Portada' && item.label === 'Portada' || sesiones.enlace === 'panel_de_clase' && item.label === 'Panel de Clase' || sesiones.enlace === 'trabajos' && item.label === 'Trabajos';
                        // Lógica para determinar si el elemento está activo
                        if (isActive && item.imageHover) {
                            imgSrc = item.imageHover;
                        }
                    %>
                    <li class="<%= (isActive) ? 'active' : '' %>" data-default-src="<%= item.image %>" data-hover-src="<%= item.imageHover || item.image %>" onmouseover="if (!this.classList.contains('active')) { this.querySelector('a img').src = this.dataset.hoverSrc; }" onmouseout="if (!this.classList.contains('active')) { this.querySelector('a img').src = this.dataset.defaultSrc; }">
                        <a href="#" onclick="manejarMateriaClick('<%= item.label %>')" title="<%= item.label %>">
                            <img src="<%= imgSrc %>" alt="<%= item.label %>" class="navbar-panelmaterias">
                        </a>
                    </li>
                <% }) %>
            </ul>
        <% } %>
    </div>
    <!-- Fin de Iteración del array 'comision' -->

    <!--Sección Informativa de la Comisión -->
    <div>
        <div id="cabeceraComision"></div>
        <% if (sesiones.rol === 'instructor' && sesiones.enlace === 'panel_de_clase' && !sesiones.trabajo || sesiones.rol === 'instructor' && sesiones.enlace === 'trabajos' && !sesiones.trabajo) { %>
            <div>
                <button id="miBoton" class="input-enviar btn-style btn-active btn-form">Mostrar Formulario</button>
            </div>
        <% } %>
    </div>
    <!-- Fin de Sección Informativa del Panel de la Clase -->

    <!-- Contenido de cada item seleccionado -->
    <div style="height: 75%;"> <!-- clase a modo prueba -->
    <% if (sesiones.enlace) { %>
        <%- include(`${sesiones.enlace}.ejs`) %>
    <% } else { %>
        <%- include('portada.ejs') %>
    <% } %>
    </div>
    <!-- Fin de Contenido de cada item seleccionado -->
</div>
<script>
    function actualizarComision() {
        fetch('/actualizarComision', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(recibir => recibir.json())
        .then(recibido => {
            const listaComision = document.getElementById('cabeceraComision');
            listaComision.innerHTML = '';
            let html = ''; // Asegúrate de inicializar la variable html como una cadena vacía.

            recibido.comision.forEach(comision => { // Iterar sobre cada comisión
                html += `
                    <div class="card-materias">
                        <div>
                            <div>
				                <h2 class="title-content">${comision.Materia}</h2>
				            </div>
                            <div class="content-card-materia">
                                <div>
                                    <p>Comision: ${comision.Comision}</p>
                                    <p>Turno: ${comision.Turnos}</p>
				                </div>
				                <div>
					                <p>${comision.Horarios}</p> 
				                </div>
                                <div>
					                <p>Profesor: ${comision.Instructores}</p>
				                </div>
                            </div>
                        </div>
                    </div>
                `;
            });
            listaComision.innerHTML = html;
        });
    }
    actualizarComision();
</script>
<script>
    let boton = document.getElementById('miBoton');
    let formulario = document.getElementById('formulario');
    let visible = false;
    boton.addEventListener('click', function(){
        if(!visible) {
            formulario.style.display = 'flex';
            boton.textContent = 'Ocultar Formulario';
            visible = true;
        } else {
            formulario.style.display = 'none';
            boton.textContent = 'Mostrar Formulario';
            visible = false;
        }
    })
</script>
