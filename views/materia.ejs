<h1><%= sesiones.comision %></h1>
<!-- Iteración del array 'comision' -->
<% if (comision) { %>
    <ul>
        <% comision.forEach(item => { %>
            <li><a href="#" onclick="manejarMateriaClick('<%= item %>')" title="<%= item %>"><%= item %></a></li>
        <% }) %>
    </ul>
<% } %>
<!-- Fin de Iteración del array 'comision' -->
<!--Sección Informativa de la Comisión -->
<div>
    <!-- Título de la Comisión -->
    <div></div>
    <!-- Fin de Título de la Comisión -->
    <!-- Información de la Comisión -->
    <div>
        <!-- Comision y Turno de la Comisión-->
        <div></div> 
        <!-- Fin de la Comision y Turno de la Comisión-->
        <!-- Días y Horarios de la Comisión -->
        <div></div>
        <!-- Fin de Días y Horarios de la Comisión -->
        <!-- Nombres de Coordinador de Carrera e Instructor de la Comisión -->
        <div></div>
        <!-- Fin de Nombres de Coordinador de Carrera e Instructor de la Comisión -->
    </div>
    <!-- Fin de Información de la Comisión -->
</div>
<!-- Fin de Sección Informativa del Panel de la Clase -->
<!-- Contenido de cada item seleccionado -->
<% if (sesiones.enlace) { %>
    <%- include(`${sesiones.enlace}.ejs`) %>
<% } else { %>
    <%- include('portada.ejs') %>
<% } %>
<!-- Fin de Contenido de cada item seleccionado -->