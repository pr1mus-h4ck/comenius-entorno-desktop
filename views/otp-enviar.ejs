<div class="form-box login">
    <div class="form-otp">
        <div class="text-cabecera-login">
            <p>Paso 1/2</p>
            <h2>OTP Verificacion</h2> 
            <p>Comprobacion por Email</p>
        </div>
        <div class="text-content">
            <p>Te enviaremos el código de verificación al siguiente correo.</p>
        </div>
        <div class="etiqueta-correo">
            <%= procesoOTP.correo %>
        </div>
        <form action="/enviar-otp" method="post">
            <button type="submit" class="btn btn-aceptar">Continuar</button>
        </form>
    </div>
</div>
<div class="toggle-box">
    <div class="toggle-panel toggle-left">
        <img src="./recursos/img/pre-logo.svg" alt="" class="imagen-form-login">
        <h2>¿Te arrepentiste?</h2>
        <p>Haz click en "Cancelar" para volver al inicio.</p>
        <button class="btn btn-aceptar" onclick="avisoCancelar();">Cancelar</button>
    </div>
</div>
<script>
    function avisoCancelar() {
        document.getElementById('contenido').style.display = 'block';
        document.getElementById('alerta-personalizada').style.display = 'block';
        document.getElementById('alerta-personalizada').classList.add('aviso');
        document.getElementById('titulo-alerta-personalizada').innerHTML = 'Estás a punto de Cancelar el<br>Proceso de Autenticación';
        document.getElementById('mensaje-alerta-personalizada').innerHTML = '¿Estás seguro/a de querer Cancelar el Proceso?';
        document.getElementById('boton-alerta-cancelar').style.display = 'block';
        document.getElementById('boton-alerta-no-cancelar').style.display = 'block';
    }
    function redirigir() {
        window.location.href = '/';
    }
</script>