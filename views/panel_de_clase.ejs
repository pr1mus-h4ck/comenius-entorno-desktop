<!-- Panel de Clase -->
<div class="publicacion">
    <% if (sesiones.rol === 'instructor') { %>
        <!-- Formulario para la Creación de Publicación -->
        <form action="/crearPublicacion" method="POST" onsubmit="enviarPublicacion(event)">
            <input type="text" id="publicacion-titulo" placeholder="Ingresar un título (opcional)" name="publicacion-titulo">
            <input type="text" id="publicacion" placeholder="Crear publicación" name="publicacion">
            <input type="submit" value="enviar"> 
        </form>
        <!-- Fin de Formulario para la Creación de Publicación -->
    <% } %>
    <!-- Lista de Publicación -->
    <div id="listaPublicacion"></div>
    <!-- Fin de Lista de Publicación -->
</div> 
<!-- Fin de Panel de Clase -->
<!-- TODO: los script separarlos a otra carpeta y llamarlos con src -->
<!-- Crear Publicación -->
<script>
    function enviarPublicacion(event) {
        event.preventDefault(); // Evita el envío del formulario por defecto
        const titulo = document.querySelector('input[name="publicacion-titulo"]').value;
        const publicacion = document.querySelector('input[name="publicacion"]').value;
        if (publicacion !== '') {
            const fechaHoraActual = new Date();
            let publi = {
                titulo: titulo,
                publicacion: publicacion,
                fechaHora: fechaHoraActual,
            }
            const publiJSON = JSON.stringify(publi);
            fetch(`/crearPublicacion`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: publiJSON,
            })
            .then(recibir => recibir.json())
            .then(recibido => {
                // TODO: Reemplazar esta recarga con un 'alert'
                if (recibido.ok) {
                    // Recarga la página después de recibir la respuesta exitosa
                    actualizarPublicacion(); 
                    actualizarComentario();
                } else {
                    console.log('No se pudo enviar la publicación');
                }
            })
            .catch(error => {
                // Muestra un mensaje de error al usuario
                console.error('Error al crear publicación:', error);
            });
        }
        document.getElementById('publicacion-titulo').value = '';
        document.getElementById('publicacion').value = '';
    }
</script>
<!-- Fin de Crear Publicación -->
<!-- Actualizar Publicaciones -->
<script>
    function actualizarPublicacion() {
        fetch('/actualizarPublicacion', { 
            method: 'POST', 
            headers: { 
                'Content-Type': 'application/json'
            }
        })
        .then(recibir => recibir.json())
        .then(recibido => {
            console.log(recibido);
            const listaPublicacion = document.getElementById('listaPublicacion');
            listaPublicacion.innerHTML = ''; // Limpia el contenido actual
            recibido.publicaciones.forEach(publicacion => {
                const listaPublicacion = document.getElementById('listaPublicacion');
                listaPublicacion.innerHTML = ''; // Limpia el contenido actual
                recibido.publicaciones.forEach(publicacion => {
                    // Crea el HTML para cada publicación (sin comentarios)
                    const html = `
                        <section>
                            <article id="listaComentario">
                                <div>
                                    <span>${publicacion.NombreCompleto}</span>
                                    <span>${publicacion.FechaHora}</span>
                                </div>
                                <div>
                                    <h2>${publicacion.Titulo}</h2>
                                    <p>${publicacion.Contenido}</p>
                                </div>
                            </article>
                            <form action="/crearComentario" method="POST" onsubmit="enviarComentario(event)">
                                <input type="text" id="comentario" placeholder="Escribir comentario..." name="comentario">
                                <input type="submit" value="enviar"> 
                            </form>
                        </section>
                    `;
                    // Agrega el HTML al contenedor
                    listaPublicacion.innerHTML += html;
                });
            });
        })
    }
    actualizarPublicacion();
    actualizarComentario();
</script>
<!-- Fin de Actualizar Publicaciones -->
<!-- Crear Comentarios -->
<script>
    function enviarComentario(event) {
        event.preventDefault(); // Evita el envío del formulario por defecto
        const comentario = document.querySelector('input[name="comentario"]').value;
        if (comentario !== '') {
            const fechaHoraActual = new Date();
            let publi = {
                comentario: comentario,
                fechaHora: fechaHoraActual,
            }
            const publiJSON = JSON.stringify(publi);
            fetch(`http://localhost:3000/crearComentario`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: publiJSON,
            })
            .then(recibir => recibir.json())
            .then(recibido => {
                // TODO: Reemplazar esta recarga con un 'alert'
                if (recibido.ok) {
                    // Recarga la página después de recibir la respuesta exitosa
                    actualizarComentario(); 
                } else {
                    console.log('No se pudo enviar el comentario');
                }
            })
            .catch(error => {
                // Muestra un mensaje de error al usuario
                console.error('Error al crear comentario:', error);
            });
        }
        document.getElementById('comentario').value = '';
    }
</script>
<!-- Fin de Crear Comentarios -->
<!-- Actualizar Comentarios -->
<script>
    function actualizarComentario() { 
        fetch('http://localhost:3000/actualizarComentario', { 
            method: 'POST', 
            headers: { 
                'Content-Type': 'application/json'
            }
        })
        .then(recibir => recibir.json())
        .then(recibido => {
        const listaComentario = document.getElementById('listaComentario');
            listaComentario.innerHTML = ''; // Limpia el contenido actual
            recibido.comentarios.forEach(comentario => {
                const listaComentario = document.getElementById('listaComentario');
                listaComentario.innerHTML = ''; // Limpia el contenido actual
                recibido.comentarios.forEach(comentario => {
                    // Crea el HTML para cada publicación (sin comentarios)
                    const html = `<p>${comentario.content}</p>`;
                    // Agrega el HTML al contenedor
                    listaComentario.innerHTML += html;
                });
            });
        })
    }
    actualizarComentario();
</script>
<!-- Fin de Actualizar Comentarios -->