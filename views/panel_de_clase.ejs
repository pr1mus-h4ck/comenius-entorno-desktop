<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de la clase</title>
</head>
<body>
    <!--Menu horizontal del panel de la clase: Panel, Trabajos, Clase Virtual-->
    <div class="menu_materia"></div> 
<main>
    <!--Todo esto es el PANEL DE LA CLASE DE LA MATERIA: ej, base de datos-->
<div> <!--Sección informativa del panel de la clase: comision, turno, dias, etc-->
    <div></div> <!--Titulo de la materia, ej: Base de datos-->
    <div> <!--Divs con la información de la materia-->
        <div></div> <!--comision, turno-->
        <div></div> <!--fecha y hora de la materia-->
        <div></div> <!--coordinador, profesor-->
</div>
<!--TODO: hacer el CSS con su flexbox y grid pero sin tocar el contenido de los div de la abajo-->
<div>
    <div><!--Lista de integrantes-->
        <h3>Integrantes</h3>
        <div></div>
    </div> 
    <!-- FIXME: corregir la falta de la actualización de ventana con una barra de carga con HTML5 y CSS3 en unión con routerPost.js -->
    <div class="publicacion">   <!--Foro de la materia-->
        <form action="/crearPublicacion" method="POST">
            <input type="text" id="" placeholder="Crear publicación" name="publicacion">
            <input type="submit" value="enviar"> 
        </form>
        <!--TODO: HACER UN EVENTO en el div para que actualice cada 5 segundos el contenido de dicho div-->
        <div id="listaPublicacion">
            <% if (publicaciones.publicacion) { %>
                <% publicaciones.publicacion.forEach(publicacion => { %>
                    <section>
                        <h1>
                            <%= publicacion.content %>
                        </h1>
                        <!-- TODO: hacer lógica con EJS los ids de los formularios para comantar cada publicación creada -->
                        <div id="listaComentario">
                            <% if (comentarios.comentario) { %>
                                <% comentarios.comentario.forEach(comentario => { %>
                                    <article>
                                        <%= comentario.content %>
                                    </article>
                                <% }); %>
                            <% } %>
                        </div>
                        <form action="/crearComentario" method="POST">
                            <input type="text" id="" placeholder="Escribir comentario..." name="comentario">
                            <input type="submit" value="enviar"> 
                        </form>
                    </section>
                <% }); %>
            <% } %>
        </div> 
    </div> 
</div>
</main>
<!-- TODO: los script separarlos a otra carpeta y llamarlos con src -->
<script>
    const listaPublicacion = document.getElementById('listaPublicacion');
    function actualizarPublicacion() { 
        fetch('/actualizarPublicacion', { 
            method: 'POST', 
            headers: { 
                'Content-Type': 'application/json'
            }
        })
    }
    //FIXME: corregir el setinterval
    setInterval(actualizarPublicacion, 5000);
</script>
<script>
    const listaComentario = document.getElementById('listaComentario');
    function actualizarComentario() { 
        fetch('/actualizarComentario', { 
            method: 'POST', 
            headers: { 
                'Content-Type': 'application/json'
            }
        })
        .then(recibir => recibir.json())
        .then(recibido => {
            console.log(recibido);
        })
    }
    //FIXME: corregir el setinterval
    setInterval(actualizarComentario, 5000);
</script>
</body>
</html>