    </div> 
    <div>
        <!-- FIXME: corregir la falta de la actualización de ventana con una barra de carga con HTML5 y CSS3 en unión con routerPost.js -->
        <div class="publicacion">   <!--Foro de la materia-->
            <form action="/crearPublicacion" method="POST" onsubmit="enviarPublicacion(event)">
                <input type="text" id="publicacion" placeholder="Crear publicación" name="publicacion">
                <input type="submit" value="enviar"> 

            </form>
            <!--TODO: HACER UN EVENTO en el div para que actualice cada 5 segundos el contenido de dicho div-->
            <div id="listaPublicacion">
                <% if (publicaciones.publicacion) { %>
                    <% publicaciones.publicacion.forEach(publicacion => { %>
                        <section>
                            <h1>
                                <%= publicacion.content %>
                            </h1>
                            <!-- TODO: hacer lógica con EJS los ids de los formularios para comantar cada publicación creada -->
                            <div id="listaComentario">
                                <% if (comentarios.comentario) { %>
                                    <% comentarios.comentario.forEach(comentario => { %>
                                        <article>
                                            <%= comentario.content %>
                                        </article>
                                    <% }); %>
                                <% } %>
                            </div>
                            <form action="/crearComentario" method="POST">
                                <input type="text" id="" placeholder="Escribir comentario..." name="comentario">
                                <input type="submit" value="enviar"> 
                            </form>
                        </section>
                    <% }); %>
                <% } %>
            </div> 
        </div> 
    </div>
</main>
<!-- TODO: los script separarlos a otra carpeta y llamarlos con src -->
<script>
    function enviarPublicacion(event) {
        event.preventDefault(); // Evita el envío del formulario por defecto
        const publicacion = document.querySelector('input[name="publicacion"]').value;
        if (publicacion !== '') {
            const fechaHoraActual = new Date();
            let publi = {
                publicacion: publicacion,
                fechaHora: fechaHoraActual,
            }
            const publiJSON = JSON.stringify(publi);
            fetch(`http://localhost:3000/crearPublicacion`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: publiJSON,
            })
            .then(recibir => recibir.json())
            .then(recibido => {
                if (recibido.ok) {
                    console.log(recibido);
                    // Recarga la página después de recibir la respuesta exitosa
                    location.reload(); 
                } else {
                    console.log('error');
                    // Muestra un mensaje de error al usuario
                }
            })
            .catch(error => {
                console.error('Error creando publicación:', error);
                // Muestra un mensaje de error al usuario
            });
        }
    }
</script>
<script>
    const listaPublicacion = document.getElementById('listaPublicacion');
    function actualizarPublicacion() { 
        fetch('/actualizarPublicacion', { 
            method: 'POST', 
            headers: { 
                'Content-Type': 'application/json'
            }
        })
        .then(recibir => recibir.json())
        .then(recibido => {
            if (recibido.ok) {
                location.reload('#listaPublicacion');
            }
        })
    }
    //FIXME: corregir el setinterval
    setInterval(actualizarPublicacion, 5000);
</script>
<script>
    const listaComentario = document.getElementById('listaComentario');
