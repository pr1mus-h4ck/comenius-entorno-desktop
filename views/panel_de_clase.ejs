<!-- Panel de Clase -->
<div class="publicacion contenedor-publicacion">
    <% if (sesiones.rol === 'instructor') { %>
        <!-- Formulario para la Creación de Publicación -->
        
        <form id="formulario" action="/crearPublicacion" method="POST" onsubmit="enviarPublicacion(event)" class="form-publicacion">
            <input type="text" id="publicacion-titulo" placeholder="Titulo (opcional)" name="publicacion-titulo" class="input-respuesta titulo">
            <input type="text" id="publicacion" placeholder="Contenido" name="publicacion" class="input-respuesta">
            <input type="submit" value="Enviar" class="input-enviar btn-style"> 
        </form>
        <!-- Fin de Formulario para la Creación de Publicación -->
    <% } %>
    <!-- Lista de Publicación -->
    <div id="listaPublicacion" class="contenido-publicacion"></div>
    <!-- Fin de Lista de Publicación -->
</div> 
<!-- Fin de Panel de Clase -->
<!-- TODO: los script separarlos a otra carpeta y llamarlos con src -->
<!-- Crear Publicación -->
<script>
    function enviarPublicacion(event) {
        event.preventDefault(); // Evita el envío del formulario por defecto
        const titulo = document.querySelector('input[name="publicacion-titulo"]').value;
        const publicacion = document.querySelector('input[name="publicacion"]').value;
        if (publicacion !== '') {
            let publi = {
                titulo: titulo,
                publicacion: publicacion,
            }
            const publiJSON = JSON.stringify(publi);
            fetch(`/crearPublicacion`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: publiJSON,
            })
            .then(recibir => recibir.json())
            .then(recibido => {
                // TODO: Reemplazar esta recarga con un 'alert'
                if (recibido.ok) {
                    // Recarga la página después de recibir la respuesta exitosa
                    actualizarPublicacion();
                } else {
                    console.log('No se pudo enviar la publicación');
                }
            })
            .catch(error => {
                // Muestra un mensaje de error al usuario
                console.error('Error al crear publicación:', error);
            });
        }
        document.getElementById('publicacion-titulo').value = '';
        document.getElementById('publicacion').value = '';
    }
</script>
<!-- Fin de Crear Publicación -->
<!-- Actualizar Publicaciones -->
<script>
    function actualizarPublicacion() {
        fetch('/actualizarPublicacion', { 
            method: 'POST', 
            headers: { 
                'Content-Type': 'application/json'
            }
        })
        .then(recibir => recibir.json())
        .then(recibido => {
            console.log(recibido);
            const listaPublicacion = document.getElementById('listaPublicacion');
            listaPublicacion.innerHTML = ''; // Limpia el contenido actual
            recibido.panelClase.forEach(publicacion => {
                // Crea el HTML para cada publicación (sin comentarios)
                const html = `
                    <section class="section-publicacion">

                        <div class="height-user">
                            <img src="./recursos/img/img-comentario.svg" alt="">
                        </div>

                        <article class="article-publicacion" id="publicacion-${publicacion.id}">
                            <div class="style-respuesta">
                            <div class="f-span">
                                <span class="bold">${publicacion.NombreCompleto}</span>
                                <span class="bold">${publicacion.FechaHora}</span>
                            </div>
                            <div>
                                ${publicacion.Titulo && publicacion.Titulo.trim() !== '' ? `<h3>${publicacion.Titulo}</h3>` : ''}
                                <p>${publicacion.Contenido}</p>
                            </div>
                            </div>
                                ${publicacion.comentarios && publicacion.comentarios.length > 0 ? `

                            <div class="contenido-respuesta" id="comentarios-${publicacion.id}">

                                ${publicacion.comentarios.map(comentario => `
                                    <div class="div-respuesta"> 
                                        <div class="height-user">
                                            <img src="./recursos/img/img-comentario.svg" alt="">
                                        </div>
                                        <div class="style-comentario">
                                            <div class="f-span">
                                                <span>${comentario.NombreCompletoComenterio}</span>
                                                <span>${comentario.FechaHoraComentario}</span>
                                            </div>
                                            
                                            <p>${comentario.ComentarioContenido}</p>
                                        </div>
                                    </div>
                                `).join('')}
                            </div>
                            
                        ` : ''}

                            <div class="div-input-respuesta">
                                <form class="form-respuesta" action="/crearComentario" method="POST" onsubmit="enviarComentario(event, ${publicacion.id})">
                                    <input type="hidden" name="publicacionId" value="${publicacion.id}">
                                    <input class="input-respuesta" type="text" id="comentario-${publicacion.id}" placeholder="Escribir comentario..." name="comentario">
                                    <input class="input-enviar btn-style" type="submit" value="Enviar">
                                </form>
                            </div>
                    </article>

                </section>
                `;
                // Agrega el HTML al contenedor
                listaPublicacion.innerHTML += html;
            });
        })
    }
    actualizarPublicacion();
</script>
<!-- Fin de Actualizar Publicaciones -->
<!-- Crear Comentarios -->
<script>
    function enviarComentario(event, publicacionId) {
        event.preventDefault(); // Evita el envío del formulario por defecto
        const comentario = document.getElementById(`comentario-${publicacionId}`).value;
        if (comentario !== '') {
            let publi = {
                comentario: comentario,
                publicacionId: publicacionId,
            }
            const publiJSON = JSON.stringify(publi);
            fetch(`/crearComentario`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: publiJSON,
            })
            .then(recibir => recibir.json())
            .then(recibido => {
                // TODO: Reemplazar esta recarga con un 'alert'
                if (recibido.ok) {
                    // Recarga la página después de recibir la respuesta exitosa
                    actualizarPublicacion(); 
                } else {
                    console.log('No se pudo enviar el comentario');
                }
            })
            .catch(error => {
                // Muestra un mensaje de error al usuario
                console.error('Error al crear comentario:', error);
            });
        }
        document.getElementById('comentario').value = '';
    }
</script>
<!-- Fin de Crear Comentarios -->