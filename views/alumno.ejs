<script>
    const crearDiasDeSemanas = (locale) => {
        const dias = [...Array(7).keys()];
        const diasDeSemanaInter = new Intl.DateTimeFormat(locale, { weekday: 'short' });
        const nombreDiasDeSemanas = dias.map((indiceDiaDeSemana) => {
            const datos = new Date(2024, 0, indiceDiaDeSemana);
            const nombreDiaDeSemana = diasDeSemanaInter.format(datos);
            return nombreDiaDeSemana;
        });
        const mostrarDiasDeSemana = nombreDiasDeSemanas.map((nombreDiaDeSemana) => `<th>${nombreDiaDeSemana}</th>`).join('');
        return mostrarDiasDeSemana;
    };
    const diasDeSemanas = crearDiasDeSemanas('es');
    const tablaCabecera = document.querySelector('.calendarioC');
    tablaCabecera.innerHTML = `${diasDeSemanas}`;
    // FIXME: Agregar los números sin romper funciones de petición
</script>