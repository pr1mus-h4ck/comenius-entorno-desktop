<script>
    function actualizarTrabajoInstructor() {
        fetch('/actualizarTrabajoInstructor', { 
            method: 'POST', 
            headers: { 
                'Content-Type': 'application/json'
            }
        })
        .then(recibir => recibir.json())
        .then(recibido => {
            let html = '';
            // Div para la información del trabajo
            html += `
                <div id="publicacionTrabajo">
                    <h3>${recibido.Titulo}</h3>
                    <p id="contenidoTrabajo">${recibido.Contenido}</p>
                </div>
            `;
            // Div para los archivos adjuntos
            html += `
                <div id="archivosTrabajo">
                    <ul id="listaArchivos">
            `;
            // Si el Trabajo de Instructor tiene Archivos
            if (recibido.Archivos) {
                // Iterar sobre los archivos y crear los elementos de la lista
                recibido.Archivos.forEach(archivo => {
                    const imgSrc = imagenTipo[archivo.Tipo] || imagenTipo['default'];
                    html += `
                        <li>
                            <a href="${archivo.URL}" target="_blank" data-tipo="${archivo.Tipo}" title="${archivo.Nombre+'.'+archivo.Tipo}">
                                <img src="${imgSrc}" class="prueba-iconos" alt="${archivo.Tipo}">
                                <p>${archivo.Nombre}</p>
                            </a>
                        </li>
                    `;
                });
                html += `
                        </ul>
                    </div>
                `;
            }
            // Insertar el HTML en el contenedor principal
            document.getElementById('trabajoInstructor').innerHTML = html;
        })
        .catch(error => {
            console.error('Error al actualizar los trabajos:', error);
        });
    }
    actualizarTrabajoInstructor(); 
</script>
<!-- Fin de la Funsión actualizarTrabajoInstructor -->
<!-- Funsión actualizarTrabajoAlumno -->
<script>
    function actualizarTrabajoAlumno() {
        fetch('/actualizarTrabajoAlumno', { 
            method: 'POST', 
            headers: { 
                'Content-Type': 'application/json'
            }
        })
        .then(recibir => recibir.json())
        .then(recibido => {
            let html = '';
            if (recibido.ok === false) {
                html += `
                <p>Sin entregas</p>
                `;
            } else {
                // Div para los archivos adjuntos
                html += `
                    <div id="archivosEntrega">
                        <ul id="listaArchivosEntrega">
                `;
                // Iterar sobre los archivos y crear los elementos de la lista
                recibido.archivosEntregas.Archivos.forEach(archivo => {
                    const imgSrc = imagenTipo[archivo.Tipo] || imagenTipo['default'];
                    html += `
                        <li>
                            <a href="${archivo.URL}" target="_blank" data-tipo="${archivo.Tipo}" title="${archivo.Nombre+'.'+archivo.Tipo}">
                                <img class="prueba-iconos" src="${imgSrc}" alt="${archivo.Tipo}">
                                ${archivo.Nombre}
                            </a>
                        </li>
                    `;
                });
                html += `
                        </ul>
                    </div>
                `;
            }
            // Insertar el HTML en el contenedor principal
            document.getElementById('trabajoAlumno').innerHTML = html;
        })
        .catch(error => {
            console.error('Error al actualizar los trabajos:', error);
        });
    }
    actualizarTrabajoAlumno();
</script>
<!-- Fin de la Funsión actualizarTrabajoAlumno -->
<!-- Funsión irListaAlumnos -->
<script>
    function irListaAlumnos() {
        fetch('/irListaAlumnos', { 
            method: 'POST', 
            headers: { 
                'Content-Type': 'application/json'
            },
        })
        .then(respuesta => {
            // Si la respuesta es correcta
            if (respuesta) {
                // Cargar la ventana en la ruta '/'
                window.location.href = '/';
            } else {
                // Si sale error cargar en la consola del Navegador el error
                console.error('Error al hacer la petición');
            }
        });
    }
</script>
<!-- Fin de la Funsión irListaAlumnos -->
<!-- Configuración de Cloudinary -->
<script src="https://widget.cloudinary.com/v2.0/global/all.js"></script>
<script>
    const btnSubirArchivo = document.getElementById("btn-subir-archivo");
    const realizaEntrega = document.getElementById("realiza-entrega");
    let uploadedFiles = []; // Array para almacenar información sobre los archivos subidos

    let widgetCloudinary = cloudinary.createUploadWidget({
        cloudName: "dgilte6sf",
        uploadPreset: "comenius_prueba",
        multiple: true,
    }, (error, result) => {
        if (!error && result && result.event === "success") {
            // Captura la URL del archivo subido
            const fileInfo = {
                url: result.info.secure_url,
                name: result.info.original_filename // Nombre original del archivo
                // No necesitas agregar tipo MIME aquí, ya que lo extraerás en el backend.
            };
            
            uploadedFiles.push(fileInfo); // Agregar información del archivo al array
            // Mostrar el botón de entrega
            realizaEntrega.style.display = "block";
        } else {
            // Ocultar el botón de entrega si no hay archivos subidos
            if (uploadedFiles.length === 0) {
                realizaEntrega.style.display = "none";
            }
        }
    });
    // Abre el widget al hacer clic en el botón
    btnSubirArchivo.addEventListener('click', () => {
        widgetCloudinary.open();
    }, false);
</script>
<!-- Fin de Configuración de Cloudinary -->
<!-- Funsión de Crear Trabajos de Alumnos -->
<script>
    function crearTrabajosAlumnos(event) {
        event.preventDefault();
        // Crear un objeto JSON con todos los datos
        const data = {
            urlArchivos: uploadedFiles, // Enviar array con información de cada archivo
        };
        fetch('/crearTrabajosAlumnos', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json' // Especificar que estamos enviando JSON
            },
            body: JSON.stringify(data), // Convertir el objeto a JSON
        })
        .then(respuesta => {
            // Si la respuesta es correcta
            if (respuesta.ok) {
                // Cargar la ventana en la ruta '/'
                window.location.href = '/';
            } else {
                // Si sale error cargar en la consola del Navegador el error
                console.error('Error al hacer la petición');
            }
        });
    }
</script>
<!-- Fid de la Funsión de Crear Trabajos de Alumnos -->
<!-- Función de Crear Chat -->
<script>
    function crearChatTrabajo(event) {
        event.preventDefault();
        const contenidoChat = document.getElementById("chatInput").value.trimStart();
        if (!contenidoChat || contenidoChat.trim() === '') {
            alert("El campo de chat es obligatorio.");
            return; // Detener el envío del formulario
        } else {
            // Crear un objeto JSON con todos los datos
            const data = {
                chat: contenidoChat, // Enviar array con información de cada archivo
            };
            fetch('/crearChatTrabajo', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json' // Especificar que estamos enviando JSON
                },
                body: JSON.stringify(data), // Convertir el objeto a JSON
            })
            .then(respuesta => {
            // Si la respuesta es correcta
            if (respuesta.ok) {
                // Cargar la ventana en la ruta '/'
                window.location.href = '/';
            } else {
                // Si sale error cargar en la consola del Navegador el error
                console.error('Error al hacer la petición');
            }
        });
        }
    }
</script>
<!-- Fin de Función de Crear Chat -->
<!-- Función de Actualizar Chat -->
<script>
    function actualizarChatTrabajo() {
        fetch('/actualizarChatTrabajo', { 
            method: 'POST', 
            headers: { 
                'Content-Type': 'application/json'
            }
        })
        .then(recibir => recibir.json())
        .then(recibido => {
            const listarChat = document.getElementById('chat');
            listarChat.innerHTML = ''; // Limpia el contenedor solo una vez
            recibido.chat.forEach(chat => {
                const html = `
                    <div class="prueba-chat">
                    <div>
                        <p>${chat.FechaHora}</p>
                    </div>
                    <div>
                        <p>${chat.EmisorNombreCompleto}</p>
                    </div>
                    <div>
                        <p>${chat.Contenido}</p>
                    </div>
                    </div>
                `;
                // Agrega el HTML al contenedor
                listarChat.innerHTML += html;
            });
        });
    }
    actualizarChatTrabajo();
</script>
<!-- Fin de Función de Actualizar Chat -->