<% if (sesiones.alumno) { %>
    <!-- Boton para volver a la Lista de los Alumnos -->
    <button class="btn-volver btn-style" onclick="irListaAlumnos()">Volver</button>
    <!-- Fin de Boton para volver a la Lista de los Alumnos -->
<% } %>
<div class="grid-template-entrega">
    <!-- 1° Contenedor -->
<div>
    <!-- Trabajo creado por Instructor -->
    <div id="trabajoInstructor">

    </div>
    <!-- Fin de Trabajo creado por Instructor -->
    <!-- Entraga del Alumno -->
    <div id="trabajoAlumno"></div>
    <!-- Fin de Entraga del Alumno -->
</div>
<!-- Fin del 1° Contenedor -->
<!-- 2° Contenedor -->
<div class="style-chat">
    <% if (sesiones.rol === 'alumno') { %>
        <!-- Subida y Entraga de Archivos de los Alumnos -->
        <form action="/crearTrabajosAlumnos" method="post" onsubmit="crearTrabajosAlumnos(event)" class="prueba-botones-row">
            <!-- Botón de 'Subir Archivo' -->
            <div class="btn-50">
                <button class="btn-chat btn-style btn-100" id="btn-subir-archivo" type="button" required>Subir Archivo</button>
            </div>
            <!-- Fin del Botón de 'Subir Archivo' -->
            <!-- Botón de 'Crear Trabajo Alumnos' -->
            <div id="realiza-entrega" style="display: none;" class="btn-50">
                <button class="btn-volver btn-chat btn-style btn-100" type="submit">Enviar</button>
            </div>
            <!-- Fin de Botón de 'Crear Trabajo Alumnos' -->
        </form>
        <!-- Fin de la Subida y Entraga de Archivos de los Alumnos -->
    <% } %>
    <!-- Chat -->
    <div id="trabajoChat">
        <div id="chat" class="prueba-fondo-chat"></div>
        <div>
            <form action="/crearChat" class="btn-chat-form" method="post" onsubmit="crearChatTrabajo(event)">
                <label for="chatInput" style="display: none;">Mensaje:</label>
                <textarea name="chatInput" id="chatInput" placeholder="Escribe tu mensaje aquí..." required></textarea>
                <button class="btn-enviar-chat btn-style" type="submit">Enviar</button>
            </form>
        </div>
    </div>
    <!-- Fin del Chat -->
</div>
<!-- Fin del 2° Contenedor -->
</div>
