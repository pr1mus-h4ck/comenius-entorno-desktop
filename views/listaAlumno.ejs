<div class="lista-alumno-trabajo">
<div class="lista-alumno-fondo">
<h2>Lista de Usuarios Asignados</h2>
<!-- Lista de Alumnos -->
<div id="listaAlumnos"></div>
<!-- Fin de Lista de Alumnos -->
<!-- Actualización de la Lista de Alumnos -->
</div>
</div>

<script>
    function actualizarAlumnos() {
        fetch('/actualizarAlumnos', { 
            method: 'POST', 
            headers: { 
                'Content-Type': 'application/json'
            }
        })
        .then(recibir => recibir.json())
        .then(recibido => {
            console.log('id: '+recibido.id);
            console.log('Nombre: '+recibido.Nombre);
            let html = ''; // Inicializa la variable html como una cadena vacía
            recibido.listaAlumnos.forEach(alumno => {
                html += `
                    <div class="alumno fondo-alumno">
                        <a href="#" onclick="guardarIdEnCookie('${alumno.id}')"><p>${alumno.Nombre}</p></a>
                    </div>
                `;
            });
            const listaAlumnos = document.getElementById('listaAlumnos');
            listaAlumnos.innerHTML = html; // Asigna el HTML generado a la lista
        });
    }
    function guardarIdEnCookie(id) {
        const dato = {
            listaAlumno: `${id}`,
        }
        const datoJson = JSON.stringify(dato);
        fetch('/seccionListaAlumno', { 
            method: 'POST', 
            headers: { 
                'Content-Type': 'application/json'
            },
            body: datoJson
        })
        .then(respuesta => {
            // Si la respuesta es correcta
            if (respuesta) {
                // Cargar la ventana en la ruta '/'
                window.location.href = '/';
            } else {
                // Si sale error cargar en la consola del Navegador el error
                console.error('Error al hacer la petición');
            }
        })
    }
    actualizarAlumnos(); 
</script>
<!-- Fin de la Actualización de la Lista de Alumnos -->