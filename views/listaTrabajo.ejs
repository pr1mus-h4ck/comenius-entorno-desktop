<!-- Trabajos -->
<div class="trabajos">
    <!-- Formulario de la Creación de Trabajo -->
    <% if (sesiones.rol === 'instructor' && !sesiones.trabajo) { %>
        <form id="formulario" action="/crearTrabajos" method="post" onsubmit="crearTrabajos(event)" class="form-publicacion form-trabajo">
            <div class="div-titulo-url">
                <!-- Título -->
                <input type="text" name="titulo" id="titulo" placeholder="Titulo" required>
                <!-- Fin de Título -->
                 <!-- Archivo -->
                <input type="text" id="url-archivo" placeholder="URL del archivo" readonly>
                <!-- Fin de Archivo -->
            </div>
            <div class="div-btn-textarea">
                <!-- Contenido -->
                <textarea name="contenidos" id="contenidos" placeholder="Contenido" required></textarea>
                <!-- Fin de Contenido -->
                <button class="btn-style" type="button" id="btn-subir-archivo">Subir Archivo</button>
                <input class="btn-style" type="submit" value="Crear Trabajo">
            </div>
        </form>
    <% } %>
    <!-- Fin de Formulario de la Creación de Trabajo -->
    <!-- Lista de Trabajos -->
    <div id="listaTrabajos"></div>
    <!-- Fin de Lista de Trabajos -->
</div>
<!-- Fin de Trabajos -->
<!-- Configuración de Cloudinary -->
<script src="https://widget.cloudinary.com/v2.0/global/all.js"></script>
<script>
    const btnSubirArchivo = document.getElementById("btn-subir-archivo");
    const urlArchivoInput = document.getElementById("url-archivo");
    let uploadedFiles = []; // Array para almacenar información sobre los archivos subidos

    let widgetCloudinary = cloudinary.createUploadWidget({
        cloudName: "dgilte6sf",
        uploadPreset: "comenius_prueba",
        multiple: true,
    }, (error, result) => {
        if (!error && result && result.event === "success") {
            // Captura la URL del archivo subido
            const fileInfo = {
                url: result.info.secure_url,
                name: result.info.original_filename // Nombre original del archivo
                // No necesitas agregar tipo MIME aquí, ya que lo extraerás en el backend.
            };

            uploadedFiles.push(fileInfo); // Agregar información del archivo al array
            urlArchivoInput.value = uploadedFiles.map(file => file.url).join(', '); // Mostrar todas las URLs
        }
    });
    // Abre el widget al hacer clic en el botón
    btnSubirArchivo.addEventListener('click', () => {
        widgetCloudinary.open();
    }, false);
</script>
<!-- Fin de Configuración de Cloudinary -->
<!-- Crear Trabajos -->
<script>
    function crearTrabajos(event) {
        event.preventDefault();
        const titulo = document.querySelector('input[name="titulo"]').value;
        const contenido = document.querySelector('textarea[name="contenidos"]').value;
        if (titulo !== '' && contenido !== '') {
            // Crear un objeto JSON con todos los datos
            const data = {
                titulo: titulo,
                contenido: contenido,
                urlArchivos: uploadedFiles, // Enviar array con información de cada archivo
            };
            fetch('/crearTrabajos', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json' // Especificar que estamos enviando JSON
                },
                body: JSON.stringify(data), // Convertir el objeto a JSON
            })
            .then(recibir => {
                if (!recibir.ok) {
                    throw new Error('Error en la solicitud');
                }
                return recibir.json();
            })
            .then(recibido => {
                if (recibido.ok) {
                    // Limpiar campos de formulario
                    uploadedFiles = []; // Reiniciar array
                    urlArchivoInput.value = '';
                    document.getElementById("titulo").value = '';
                    document.getElementById("contenidos").value = '';
                    // Activo el estilo bloqueado, '#contenido' por 'alertas.css'
                    document.getElementById('contenido').style.display = 'block';
                    // Activo el estilo bloqueado, '#alerta-personalizada' por 'alertas.css'
                    document.getElementById('alerta-personalizada').style.display = 'block';
                    // Agrego texto a la etiqueta con la ID '#titulo-alerta-personalizada'
                    document.getElementById('titulo-alerta-personalizada').innerText = '¡Muy Bien!';
                    // Agrego texto a la etiqueta con la ID '#mensaje-alerta-personalizada'
                    document.getElementById('mensaje-alerta-personalizada').innerText = '¡Se ha creado la publicación con éxito!';
                    // Agrego una clase a la etiqueca con la ID '#alerta-personalizada' para cambiar el color de la alerta
                    document.getElementById('alerta-personalizada').classList.add('exito');
                    setTimeout(function(){
                        // Redireccionar a la página principal después de 1500 milisegundos en caso de éxito
                        window.location.href = '/';
                    }, 1500);
                }
    
            })
            .catch(error => {
                servidorAviso();
            });
        } else {
            listaTrabajosAviso();
        }
    }
</script>
<!-- Fin de Crear Trabajos -->
<!-- Actualizar Trabajos -->
<script>
    function actualizarTrabajos() {
        fetch('/actualizarTrabajos', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(recibir => recibir.json())
        .then(recibido => {
            let html = ''; // Inicializa la variable html como una cadena vacía
            if (!recibido.tipo) {
                recibido.trabajos.forEach(trabajo => {
                    // Genera un ID único para cada imagen SVG
                    const svgId = `miSvg-${trabajo.id}`;
                    html += `
                        <div class="trabajo">
                            <div>
                                <img id="${svgId}" class="svg-hover-image" src="./recursos/img/icon-listatrabajo-black.svg" alt="icon-listatrabajo-black">
                                <a href="#" onclick="guardarIdEnCookie('${trabajo.id}')">
                                    <h3>${trabajo.Titulo}</h3>
                                </a>
                            </div>
                            <p>${trabajo.FechaHora}</p>
                        </div>
                    `;
                });
                // --- Código del Hover ---
                recibido.trabajos.forEach(trabajo => {
                    const svgId = `miSvg-${trabajo.id}`;
                    const miSvgElement = document.getElementById(svgId);
                    // Asegurarse de que el elemento existe
                    if (miSvgElement) {
                        // Ruta a tu SVG original
                        const svgNormalSrc = './recursos/img/icon-listatrabajo-black.svg';
                        // Ruta a tu SVG para el hover
                        const svgHoverSrc = './recursos/img/icon-listatrabajo-white.svg';
                        // Evento al hacer Hover
                        miSvgElement.addEventListener('mouseover', () => {
                            miSvgElement.src = svgHoverSrc;
                        });
                        // Evento al finalizar el Hover
                        miSvgElement.addEventListener('mouseout', () => {
                            miSvgElement.src = svgNormalSrc;
                        });
                    }
                });
                // --- Fin del Código del Hover ---
            } else {
                html += `
                    <p class="texto-informacion">${recibido.mensaje}</p>
                `;
            }
            const listaTrabajos = document.getElementById('listaTrabajos');
            listaTrabajos.innerHTML = html; // Asigna el HTML generado a la lista
        })
        .catch(error => {
            servidorAviso();
        })
    }
    function guardarIdEnCookie(id) {
        const dato = {
            trabajo: `${id}`,
        }
        const datoJson = JSON.stringify(dato);
        fetch('/seccionTrabajo', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: datoJson
        })
        .then(respuesta => {
            // Si la respuesta es correcta
            if (respuesta) {
                // Cargar la ventana en la ruta '/'
                window.location.href = '/';
            } else {
                // Si sale error cargar en la consola del Navegador el error
                console.error('Error al hacer la petición');
            }
        })
    }
    actualizarTrabajos();
</script>
<!-- Fin de Actualizar Trabajos -->